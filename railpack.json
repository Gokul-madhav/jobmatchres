{
  "steps": {
    "install-backend": {
      "commands": [
        "pip install --upgrade pip",
        "pip install -e ."
      ]
    },
    "install-frontend": {
      "commands": [
        "cd rezjd && npm install"
      ]
    },
    "build-frontend": {
      "inputs": [
        {
          "step": "install-frontend"
        }
      ],
      "commands": [
        "cd rezjd && npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port 8000"
  }
}
